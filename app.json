{
  "expo": {
    "name": "Krifoo Admin",
    "slug": "krifoo-admin",
    "owner": "krifoos-app",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "krifooadmin",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5C39"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krifoo.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.krifoo.admin",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#FF5C39",
          "sounds": [
            "./assets/sounds/order_buzz.wav"
          ],
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e0c6426-9675-4b81-a428-1642374aa42b"
      }
    }
  }
}