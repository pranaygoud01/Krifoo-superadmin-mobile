{
  "expo": {
    "name": "Krifoo Admin",
    "slug": "krifoo-admin",
    "owner": "krifoos-app",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "krifooadmin",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5C39"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krifoo.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "This app requires Bluetooth access to discover and print receipt orders on thermal receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "This app requires Bluetooth access to connect to thermal receipt printers.",
        "NSLocalNetworkUsageDescription": "This app requires Local Network access to discover and print receipts on network printers (Epson TM-m30III).",
        "UISupportedExternalAccessoryProtocols": [
          "com.epson.epos.print"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.krifoo.admin",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CHANGE_WIFI_MULTICAST_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#FF5C39",
          "sounds": [
            "./assets/sounds/order_buzz.wav"
          ],
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e0c6426-9675-4b81-a428-1642374aa42b"
      }
    }
  }
}